+                .hints()
+                .iter()
+                .all(|h| matches!(h.target.id, Action::Close | Action::Submit))
+        );
+        app.key(KeyEvent::new(KeyCode::Char('z'), KeyModifiers::NONE));
+        assert_eq!(app.input, "f");
+        hint_key(&mut app, Action::Close);
+        assert!(app.modal.is_none());
+        assert!(!app.hints.is_active());
+        app.act(Action::More(0));
+        draw_app(&mut app, 150, 54);
+        // The More dialog's existing f binding still follows the author.
+        app.key(KeyEvent::new(KeyCode::Char('f'), KeyModifiers::NONE));
+        assert!(app.saved.following.contains(&app.stories[0].handle));
