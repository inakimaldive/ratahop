+    #[test]
+    fn hints_dispatch_existing_actions_without_shortcut_leakage() {
+        let mut app = app();
+        draw_app(&mut app, 150, 54);
+        app.key(KeyEvent::new(KeyCode::Char('f'), KeyModifiers::NONE));
+        assert!(app.hints.is_active());
+        // Invalid q must not quit the app; j must not move the story while hinting.
+        assert!(!app.key(KeyEvent::new(KeyCode::Char('q'), KeyModifiers::NONE)));
+        assert!(app.hints.is_active());
+        let selected = app.selected;
+        hint_key(&mut app, Action::Bookmark(0));
+        assert_eq!(app.selected, selected);
+        assert_eq!(app.saved.bookmarked, vec![app.stories[0].url.clone()]);
+        assert!(!app.hints.is_active());
+        let saved: Saved =
+            serde_json::from_slice(&std::fs::read(&app.state_path).unwrap()).unwrap();
+        assert_eq!(saved.bookmarked, app.saved.bookmarked);
+        let _ = std::fs::remove_dir_all(app.state_path.parent().unwrap());
+    }
