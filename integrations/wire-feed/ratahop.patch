+        app.key(KeyEvent::new(KeyCode::Char('f'), KeyModifiers::NONE));
+        assert_eq!(app.input, "f");
+        assert!(!app.hints.is_active());
+        app.key(KeyEvent::new(KeyCode::Char('f'), KeyModifiers::ALT));
+        assert!(app.hints.is_active());
+        assert!(
